# ── Copy this file to ".env" and fill in the real values. ──
# The real .env is gitignored and must never be committed.

# Server
PORT=3000

# WhatsApp / Meta Cloud API  (filled in at Stage 1)
WHATSAPP_VERIFY_TOKEN=         # a random string YOU invent; entered in Meta webhook config
WHATSAPP_ACCESS_TOKEN=         # Meta access token (the API bearer token)
WHATSAPP_PHONE_NUMBER_ID=      # Meta "Phone Number ID" from the WhatsApp test number
WHATSAPP_BUSINESS_ACCOUNT_ID=  # Meta "WhatsApp Business Account ID"

# Claude (Anthropic)  (filled in at Stage 4)
CLAUDE_API_KEY=

# Supabase  (filled in at Stage 3)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # use the SERVICE_ROLE key (server-side, bypasses RLS)

# Cal.com  (filled in at Stage 7)
CAL_WEBHOOK_SECRET=
CAL_LINK=                      # the public booking link the bot sends to patients
