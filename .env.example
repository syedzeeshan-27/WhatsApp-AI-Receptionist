# Copy this file to ".env" (never commit .env).
#   PowerShell:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
#
# EVERYTHING here is optional. With no values at all the bot still runs:
# web chat demo at http://localhost:3000, offline keyword replies, memory storage.
# Fill in sections as you need them.

PORT=3000

# ── AI (Anthropic Claude) ─────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com. Without it, replies come from simple
# keyword matching on knowledge/faq.md (fine for clicking around, not smart).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5

# ── Business ──────────────────────────────────────────────────────────────────
# Timezone for appointment times in messages (IANA name, e.g. America/New_York).
TIMEZONE=UTC

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
# From developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_VERIFY_TOKEN=          # any random string you invent; paste the same one into Meta's webhook settings
WHATSAPP_ACCESS_TOKEN=          # temporary tokens die after ~24h; use a System User token for anything real
WHATSAPP_PHONE_NUMBER_ID=       # "Phone number ID" (not the phone number itself)
WHATSAPP_APP_SECRET=            # App settings → Basic → App secret. Lets the bot reject fake webhook calls.

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Leave blank to keep chats in memory (lost on restart).
# Create the tables first with supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-side only, never put it in a browser

# ── Booking (Cal.com) ─────────────────────────────────────────────────────────
# Leave CAL_LINK blank and the web demo uses its own fake booking page instead.
CAL_LINK=                       # your public booking link, e.g. https://cal.com/your-clinic/30min
CAL_WEBHOOK_SECRET=             # the secret you set on the Cal.com webhook
# CAL_BASE_URL=https://cal.com  # change only if you self-host Cal.com

# ── Web chat simulator ────────────────────────────────────────────────────────
# The browser chat at "/" runs on your API key, so it's rate limited.
# Set WEB_CHAT=off on a real client deployment.
WEB_CHAT=on
WEB_CHAT_DAILY_LIMIT=300
WEB_CHAT_SESSION_LIMIT=30
# PUBLIC_URL=https://your-app.onrender.com   # only if links come out with the wrong host
